@model TechStore.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Home"
           asp-action="Productos"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Volver al catálogo

        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card border-0 shadow-lg overflow-hidden">

                <div class="row g-0">

                    <div class="col-md-6 d-flex align-items-center justify-content-center p-4 bg-light">

                        <img src="~/images/@Model.Imagen"
                             class="img-fluid"
                             alt="@Model.Nombre"
                             style="max-height: 450px; object-fit: contain;" />

                    </div>

                    <div class="col-md-6">

                        <div class="card-body p-4 p-lg-5">

                            <span class="badge bg-dark mb-3">
                                @Model.Categoria
                            </span>

                            <h1 class="fw-bold mb-3">
                                @Model.Nombre
                            </h1>

                            <p class="text-muted fs-5 mb-4">
                                @Model.Descripcion
                            </p>

                            <div class="mb-4">

                                <span class="text-muted d-block mb-1">
                                    Precio
                                </span>

                                <span class="display-6 fw-bold text-primary">
                                    $@Model.Precio.ToString("N2")
                                </span>

                            </div>

                            <div class="border-top border-bottom py-3 mb-4">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="text-muted">
                                        Disponibilidad
                                    </span>

                                    <span class="fw-semibold">
                                        @Model.Estado
                                    </span>

                                </div>

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Unidades disponibles
                                    </span>

                                    <span class="fw-semibold">
                                        @Model.Stock
                                    </span>

                                </div>

                            </div>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-controller="Home"
                                   asp-action="Productos"
                                   asp-route-categoria="@Model.Categoria"
                                   class="btn btn-primary">

                                    <i class="bi bi-grid"></i>
                                    Ver más de esta categoría

                                </a>

                                <a asp-controller="Home"
                                   asp-action="Contactenos"
                                   class="btn btn-outline-dark">

                                    <i class="bi bi-envelope"></i>
                                    Consultar producto

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>