@{
    ViewData["Title"] = "Acerca de Nosotros";
}

<div class="container mt-5">
    <h2 class="text-center mb-5">Conoce TechStore</h2>

    <!-- Implementación de CSS Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">

        <div class="p-4 border rounded shadow-sm">
            <h4 class="text-primary border-bottom pb-2">Nuestra Historia</h4>
            <p>Nacimos de la pasión por la tecnología, con el objetivo de brindar los mejores componentes y accesorios para entusiastas y profesionales en El Salvador.</p>
        </div>

        <div class="p-4 border rounded shadow-sm">
            <h4 class="text-success border-bottom pb-2">Nuestra Misión</h4>
            <p>Proveer productos tecnológicos de vanguardia, garantizando asesoría experta y una experiencia de compra inigualable para cada usuario.</p>
        </div>

        <div class="p-4 border rounded shadow-sm">
            <h4 class="text-info border-bottom pb-2">Nuestra Visión</h4>
            <p>Ser la plataforma de comercio electrónico líder en tecnología, reconocida por nuestra innovación, calidad y compromiso con la comunidad.</p>
        </div>

        <div class="p-4 border rounded shadow-sm">
            <h4 class="text-warning border-bottom pb-2">Nuestros Valores</h4>
            <ul class="mb-0">
                <li>Innovación constante</li>
                <li>Calidad garantizada</li>
                <li>Servicio al cliente</li>
                <li>Transparencia</li>
            </ul>
        </div>

    </div>
</div>
