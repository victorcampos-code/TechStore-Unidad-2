@model IEnumerable<TechStore.Models.Producto>

<div class="container mt-4">
    <h2>Módulo de Productos (CRUD)</h2>
    <p><a asp-action="Create" class="btn btn-primary">Agregar Nuevo Producto</a></p>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="~/images/@item.Imagen" width="50" style="object-fit:contain;" /></td>
                    <td>@item.Nombre</td>
                    <td>@item.Categoria.Nombre</td>
                    <td>$@item.Precio</td>
                    <td>@item.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
